{"text": "\ufe94\ufee3\ufefc\ufeb4\ufedf\u0627 \u062a\ufe8e\ufee3\ufeee\ufee0\ufecc\ufee3 \u0646\ufe8e\ufee4\ufec0\ufedf \ufede\ufee3\ufe8e\ufedc\ufedf\ufe8e\ufe91 \ufede\ufef4\ufedf\ufeaa\ufedf\u0627 \u0627\ufeac\ufeeb \u0629\u0621\u0627\ufeae\ufed7 \ufef0\ufe9f\ufeae\ufef3 \u060c\u0629\ufeaa\ufef3\ufeaa\ufcc9\u0627 Samsung \ufe94\ufe9f\ufefc\ufe9b \u0645\u0627\ufeaa\ufea8\ufe98\ufeb3\u0627 \ufede\ufe92\ufed7 \u2022 \ufee6\ufee3\u0622 \ufeee\ufea4\ufee7 \ufef0\ufee0\ufecb \ufeaa\ufef3\ufeaa\ufcc9\u0627 \u0632\ufe8e\ufeec\ufcc9\u0627 \ufe8e\ufeeb\ufeae\ufed3\ufeee\ufef3 \ufef2\ufe98\ufedf\u0627 \ufed2\ufe8b\ufe8e\ufec7\ufeee\ufedf\u0627\u0648 \u062a\u0627\ufeb0\ufef4\ufccc\u0627 \ufede\ufef4\ufed0\ufeb8\ufe97 \ufe94\ufef4\ufed4\ufef4\ufedc\ufe91 \ufeda\ufe98\ufed3\ufeae\ufecc\ufee3 . \ufe94\ufef4\ufedf\ufe8e\ufecb \u0629\u0621\ufe8e\ufed4\ufedc\ufe91\u0648 \ufee6\ufcd1 (\u0644\ufe8e\ufed4\ufec3\ufef7\u0627 \ufeda\ufedf\u0630 \ufef2\ufed3 \ufe8e\ufc9f) \u0635\ufe8e\ufea8\ufeb7\ufef7\u0627 \ufebe\ufecc\ufe91 \ufeea\ufee3\ufeaa\ufea8\ufe98\ufeb4\ufef4\ufedf \u0632\ufe8e\ufeec\ufcc9\u0627 \u0627\ufeac\ufeeb \ufee2\ufef4\ufee4\ufebc\ufe97 \ufee2\ufe98\ufef3 \ufee2\ufedf \u2022 \u060c\ufe94\ufed3\ufeae\ufecc\ufccc\u0627\u0648 \u0629\ufeae\ufe92\ufccb\u0627 \ufe94\ufee0\ufed7 \u0648\u0623 \u060c\ufe94\ufef4\ufee0\ufed8\ufecc\ufedf\u0627 \u0648\u0623 \ufe94\ufef4\ufeb4\ufcca\u0627 \u0648\u0623 \ufe94\ufef3\ufeaa\ufeb4\ufcc9\u0627 \u062a\ufe8e\ufee7\ufe8e\ufedc\ufee3\ufef9\u0627 \ufef2\ufed3 \ufed2\ufecc\ufebf \ufee6\ufee3 \u0646\ufeee\ufee7\ufe8e\ufecc\ufef3 \ufe94\ufebb\ufe8e\ufccb\u0627 \u062a\u0627\u062f\ufe8e\ufeb7\u0631\ufef9\u0627 \ufee2\ufeec\ufef4\ufec4\ufecc\ufef3 \u0648\u0623 \ufee2\ufeec\ufe98\ufee3\ufefc\ufeb3 \ufee6\ufecb \ufc94\ufedf\u0648\ufe86\ufeb4\ufccc\u0627 \u0635\ufe8e\ufea8\ufeb7\ufef7\u0627 \ufeaa\ufea3\u0623 \ufee2\ufeec\ufe92\ufed7\u0627\ufeae\ufef3 \ufee2\ufedf \ufe8e\ufee3 . \u0632\ufe8e\ufeec\ufcc9\u0627 \u0645\u0627\ufeaa\ufea8\ufe98\ufeb3\u0627 \ufe94\ufef4\ufed4\ufef4\ufedc\ufe91 \ufe94\ufef4\ufeb4\ufcca\u0627 \u0648\u0623 \ufe94\ufef4\ufee7\ufeaa\ufe92\ufedf\u0627 \u062a\u0627\u0631\ufeaa\ufed8\ufedf\u0627 \u064a\u0648\u0630 \u0635\ufe8e\ufea8\ufeb7\ufef7\u0627\u0648 \ufeae\ufe9c\ufedb\ufe84\ufed3 \u062a\u0627\ufeee\ufee8\ufeb3 \u0668 \ufee6\ufeb3 \ufee6\ufee3 \u0644\ufe8e\ufed4\ufec3\ufef8\ufedf \ufea2\ufee4\ufeb4\ufe78\ufef3 \ufefb \u2022 \ufefb\u0625 \u0632\ufe8e\ufeec\ufcc9\u0627 \u0627\ufeac\ufeeb \u0645\u0627\ufeaa\ufea8\ufe98\ufeb3\ufe8e\ufe91 \ufc94\ufe98\ufee3\u0632\ufefc\ufedf\u0627 \ufe94\ufed3\ufeae\ufecc\ufccc\u0627\u0648 \u0629\ufeae\ufe92\ufccb\ufe8e\ufe91 \ufc94\ufee4\ufee0\ufccc\u0627 \ufeae\ufef4\ufecf \u0648\u0623 \u0629\u062f\u0648\ufeaa\ufd88\u0627 \ufe94\ufef4\ufee0\ufed8\ufecc\ufedf\u0627 \u0648\u0623 \ufe94\ufef4\ufed4\ufef4\ufedb\u0648 \ufe94\ufee8\ufee3\u0622 \ufe94\ufed8\ufef3\ufeae\ufec4\ufe91 \u0632\ufe8e\ufeec\ufcc9\u0627 \u0645\u0627\ufeaa\ufea8\ufe98\ufeb3\u0627 \ufe94\ufef4\ufed4\ufef4\ufedb \ufea2\ufebf\ufeee\ufef3 \ufeea\ufef4\ufe9f\ufeee\ufe97 \u0648\u0623 \u0641\u0627\ufeae\ufeb7\u0625 \ufe96\ufca2 \ufeda\ufedf\u0630 \ufc0e \u0627\u0630\u0625 . \ufe94\ufee0\ufee4\ufe98\ufd88\u0627 \ufeae\ufec3\ufe8e\ue005\u0627 \ufeca\ufee3 \ufede\ufee3\ufe8e\ufecc\ufe98\ufedf\u0627 \ufe94\ufee7\ufe8e\ufef4\ufebc\ufedf\u0627\u0648 \ufed2\ufef4\ufec8\ufee8\ufe98\ufedf\u0627 \u0644\ufe8e\ufee4\ufecb\ufe84\ufe91 \u0644\ufe8e\ufed4\ufec3\ufef7\u0627 \u0645\ufe8e\ufef4\ufed7 \ufeae\ufec8\ufea4\ufef3 .\u0632\ufe8e\ufeec\ufcc9\ufe8e\ufe91 \u0646\ufeee\ufe9c\ufe92\ufecc\ufef3 \u0644\ufe8e\ufed4\ufec3\ufef7\u0627 \u0643\ufeae\ufe97 \ufeae\ufec8\ufea4\ufef3 . \ufe94\ufe92\ufed7\u0627\ufeae\ufee3 \u0646\u0648\u062f \u0645\ufeaa\ufea8\ufe98\ufeb4\ufccc\u0627 \ufe8e\ufeec\ufe91 \u0645\ufeee\ufed8\ufef3 \ufef2\ufe98\ufedf\u0627 \ufed2\ufed7\u0627\ufeee\ufccc\u0627 \ufe94\ufed3\ufe8e\ufedb \ufede\ufef4\ufedf\ufeaa\ufedf\u0627 \u0627\ufeac\ufeeb \ufef2\ufed3 \u0629\u062f\u0631\u0627\ufeee\ufedf\u0627 \ufe94\ufee4\ufeec\ufccc\u0627 \ufe94\ufee3\ufefc\ufeb4\ufedf\u0627 \u062a\u0627\u062f\ufe8e\ufeb7\u0631\u0625\u0648 \u062a\u0627\ufeae\ufef3\ufeac\ufea4\ufe98\ufedf\u0627 \ufef2\ufec4\ufed0\ufe97 \ufefb \u2022 . \ufe8e\ufeec\ufe9b\u0648\ufeaa\ufea3 \ufede\ufee4\ufe98\ufd88\u0627 \u0641\u0648\ufeae\ufec8\ufedf\u0627\u0648 \ufeaa\ufee8\ufecb \ufe94\ufef3\ufe8e\ufee8\ufecc\ufedf\u0627\u0648 \ufeea\ufef4\ufe92\ufee8\ufe98\ufedf\u0627 \u0632\ufeee\ufee3\u0631\u0648 \u0645\ufe8e\ufecc\ufedf\u0627 \ufeb2\ufcca\u0627 \u0645\u0627\ufeaa\ufea8\ufe98\ufeb3\u0627 \ufe94\ufef4\ufedf\u0648\ufe86\ufeb4\ufee3 \ufeda\ufed8\ufe97\ufe8e\ufecb \ufef0\ufee0\ufecb \ufeca\ufed8\ufef3 \ufe8e\ufee4\ufedb . \ufeea\ufee0\ufef4\ufed0\ufeb8\ufe97\u0648 \ufeea\ufe98\ufee7\ufe8e\ufef4\ufebb\u0648 \u0632\ufe8e\ufeec\ufcc9\u0627 \ufe90\ufef4\ufedb\ufeae\ufe97 \ufe94\ufe9f\ufefc\ufe9c\ufedf\u0627 \ufeba\ufe8b\ufe8e\ufebc\ufea7 \ufed2\ufee0\ufe98\ufea8\ufe97 \ufeaa\ufed7 \u060c\u0629\u062f\ufeaa\ufecc\ufe98\ufee3 \u0627\ufe70\u0632\ufeae\ufec3\ufe78 \ufef2\ufec4\ufed0\ufe97 \ufe94\ufef4\ufedf\ufe8e\ufe98\ufedf\u0627 \ufede\ufef4\ufed0\ufeb8\ufe98\ufedf\u0627 \u062a\u0627\u062f\ufe8e\ufeb7\u0631\u0625 \u0646\ufef7 \ufe70\u0627\ufeae\ufec8\ufee7 \u2022 \u062a\ufe8e\ufee3\ufefc\ufecb \ufebe\ufecc\ufe91 \ufe8e\ufeec\ufef4\ufee0\ufecb \ufed6\ufe92\ufec4\ufee8\ufe97 \ufefb \ufeaa\ufed7\u0648 \ufede\ufef4\ufedf\ufeaa\ufedf\u0627 \u0627\ufeac\ufeec\ufe91 \u0629\u062f\ufeee\ufe9f\ufeee\ufccc\u0627 \ufeda\ufee0\ufe97 \ufee6\ufecb \ufe8e\ufed4\ufe70 \ufef4\ufed4\ufec3 \ufe8e\ufed3\ufe70 \ufefc\ufe98\ufea7\u0627 \ufeda\ufef3\ufeaa\ufedf \u0648\u0623 \ufe94\ufee7\ufe8e\ufef4\ufebb \ufeb0\ufedb\ufeae\ufee3 \u0628\ufeae\ufed7\ufe84\ufe91 \u0644\ufe8e\ufebc\ufe97\ufefb\u0627 \ufef0\ufe9f\ufeae\ufef4\ufed3 \u060c\u0641\u0648\ufe8e\ufea8\ufee3 \u0648\u0623 \ufe94\ufee0\ufe8c\ufeb3\u0623 \u064a\u0623 \ufeda\ufef3\ufeaa\ufedf \ufe96\ufee7\ufe8e\ufedb \u0627\u0630\u0625 .\ufeae\ufef3\ufeac\ufea4\ufe98\ufedf\u0627 . www.samsung.com \ufeca\ufed7\ufeee\ufccc\u0627 \ufef0\ufee0\ufecb \ufe96\ufee7\ufeae\ufe98\ufee7\ufef9\u0627 \ufeae\ufe92\ufecb \u062a\ufe8e\ufee3\ufeee\ufee0\ufecc\ufccc\u0627\u0648 \u062a\ufe8e\ufee4\ufef4\ufee0\ufecc\ufe98\ufedf\u0627 \ufee6\ufecb \ufe9a\ufea4\ufe92\ufedf\u0627 \ufef0\ufee0\ufecb \ufe94\ufee7\u0648\ufeaa\ufccc\u0627 \u062a\ufe8e\ufee3\ufeee\ufee0\ufecc\ufccc\u0627 \u0623\ufeae\ufed7\u0627 .\ufeaa\ufef3\ufeae\ufe92\ufe98\ufee0\ufedfR -134a\u0646 \ufeee\ufef3\ufeae\ufed4\ufedf\u0627 \u0648\u0623 R -600a\u0646 \ufe8e\ufe97\ufeee\ufef4\ufe91\u0648\ufeb0\ufef3\ufef7\u0627 \u0632\ufe8e\ufecf \u0645\ufeaa\ufea8\ufe98\ufeb4\ufe78\ufef3 \u2022 \ufede\ufea7\u0627\u062f \u062f\ufeee\ufe9f\ufeee\ufccc\u0627 \ufe94\ufed7\ufe8e\ufec4\ufedf\u0627 \ufed2\ufef4\ufee8\ufebc\ufe97 \ufed6\ufebc\ufee0\ufee3 \u0648\u0623 \u0632\ufe8e\ufeec\ufea0\ufee0\ufedf \ufef2\ufed4\ufee0\ufccb\u0627 \u0621\ufeb0\ufcc9\ufe8e\ufe91 \u062f\ufeee\ufe9f\ufeee\ufccc\u0627 \ufec2\ufecf\ufe8e\ufec0\ufedf\u0627 \ufed6\ufebc\ufee0\ufee3 \ufede\ufe91\ufe8e\ufed7 \u0632\ufe8e\ufecf \ufef0\ufee0\ufecb \ufe9e\ufe98\ufee8\ufccc\u0627 \u0627\ufeac\ufeeb \u0621\u0627\ufeee\ufe98\ufea3\u0627 \ufeaa\ufee8\ufecb .\ufe8e\ufeec\ufef4\ufed3 \u0645\ufeaa\ufea8\ufe98\ufeb4\ufccc\u0627 \ufeaa\ufef3\ufeae\ufe92\ufe98\ufedf\u0627 \u0632\ufe8e\ufecf \u0639\ufeee\ufee7 \ufe94\ufed3\ufeae\ufecc\ufccc \ufe94\ufe9f\ufefc\ufe9c\ufedf\u0627", "source": "D:\\Study\\4_Forth Semester\\AI\\project\\MultiAgent_RAG\\data\\Top Mounted Freezer SpaceMax 348L user_manual.pdf", "page": 169}