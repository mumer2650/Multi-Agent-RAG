*.py[cod]
*$py.class
.pytest_cache/
.coverage

# =========================
# 3. Frontend (React / Node.js)
# =========================
# Node modules (Massive, never commit this)
frontend/node_modules/
node_modules/

# Build directories
frontend/build/
frontend/dist/
build/
dist/

# npm and yarn debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================
# 4. Environment Variables & Secrets
# =========================
# NEVER commit your actual .env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

